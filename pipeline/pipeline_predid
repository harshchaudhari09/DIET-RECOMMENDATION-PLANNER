#!/usr/bin/env python3
"""
Prediction pipeline for CHRONIC_DISEASE_DIET_RECOMMENDATION_PLANNER.

Usage:
    python pipeline_predid.py --input input.csv --model model.joblib --output preds.csv
"""

from __future__ import annotations
import argparse
import logging
import os
import sys
import joblib
import pickle
import pandas as pd
import numpy as np
from typing import Optional, Tuple, Any, Dict

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
LOGGER = logging.getLogger("pipeline_predid")


def load_model(path: str) -> Any:
    if not os.path.exists(path):
        LOGGER.error("Model file not found: %s", path)
        raise FileNotFoundError(path)
    try:
        model = joblib.load(path)
        LOGGER.info("Loaded model with joblib: %s", path)
        return model
    except Exception:
        with open(path, "rb") as f:
            model = pickle.load(f)
        LOGGER.info("Loaded model with pickle: %s", path)
        return model


def load_optional_artifact(path: Optional[str]) -> Optional[Any]:
    if not path:
        return None
    if not os.path.exists(path):
        LOGGER.warning("Optional artifact not found, ignoring: %s", path)
        return None
    try:
        return joblib.load(path)
    except Exception:
        with open(path, "rb") as f:
            return pickle.load(f)


def prepare_features(
    df: pd.DataFrame,
    numeric_cols: Optional[list] = None,
    categorical_cols: Optional[list] = None,
    scaler: Optional[Any] = None,
    encoder: Optional[Any] = None,
) -> np.ndarray:
    # Basic automatic column detection if not provided
    if numeric_cols is None or categorical_cols is None:
        numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
        categorical_cols = [c for c in df.columns if c not in numeric_cols]
    LOGGER.info("Numeric cols: %s", numeric_cols)
    LOGGER.info("Categorical cols: %s", categorical_cols)

    num_data = df[numeric_cols].astype(float) if numeric_cols else pd.DataFrame(index=df.index)
    cat_data = df[categorical_cols].astype(object) if categorical_cols else pd.DataFrame(index=df.index)

    # Scale numeric
    if scaler and not num_data.empty:
        try:
            num_arr = scaler.transform(num_data)
        except Exception:
            num_arr = scaler.transform(num_data.values)
        LOGGER.info("Applied scaler to numeric data.")
    else:
        num_arr = num_data.values if not num_data.empty else np.empty((len(df), 0))

    # Encode categorical
    if encoder and not cat_data.empty:
        try:
            cat_arr = encoder.transform(cat_data)
            # Some encoders return sparse matrix
            if hasattr(cat_arr, "toarray"):
                cat_arr = cat_arr.toarray()
        except Exception:
            # Try transforming each column with simple mapping
            cat_arr = pd.get_dummies(cat_data).values
        LOGGER.info("Applied encoder to categorical data.")
    else:
        cat_arr = pd.get_dummies(cat_data).values if not cat_data.empty else np.empty((len(df), 0))

    features = np.hstack([num_arr, cat_arr])
    return features


def predict_from_dataframe(
    df: pd.DataFrame,
    model: Any,
    scaler: Optional[Any] = None,
    encoder: Optional[Any] = None,
    feature_columns: Optional[list] = None,
) -> Tuple[np.ndarray, Optional[np.ndarray]]:
    if feature_columns:
        missing = [c for c in feature_columns if c not in df.columns]
        if missing:
            LOGGER.error("Missing feature columns in input: %s", missing)
            raise ValueError(f"Missing feature columns: {missing}")
        df = df[feature_columns]

    X = prepare_features(df, scaler=scaler, encoder=encoder)

    # Predict probabilities if available
    y_proba = None
    try:
        if hasattr(model, "predict_proba"):
            y_proba = model.predict_proba(X)
            LOGGER.info("Predicted probabilities.")
    except Exception:
        y_proba = None

    # Predict classes / values
    try:
        y_pred = model.predict(X)
    except Exception as e:
        LOGGER.error("Model prediction failed: %s", e)
        raise

    return np.array(y_pred), y_proba


def read_input(path: str) -> pd.DataFrame:
    if not os.path.exists(path):
        raise FileNotFoundError(path)
    if path.lower().endswith(".csv"):
        return pd.read_csv(path)
    if path.lower().endswith((".xls", ".xlsx")):
        return pd.read_excel(path)
    if path.lower().endswith(".json"):
        return pd.read_json(path)
    raise ValueError("Unsupported input file format. Provide CSV, JSON, or Excel.")


def write_output(df: pd.DataFrame, path: str) -> None:
    ext = os.path.splitext(path)[1].lower()
    if ext == ".csv" or ext == "":
        df.to_csv(path, index=False)
    elif ext in (".xls", ".xlsx"):
        df.to_excel(path, index=False)
    elif ext == ".json":
        df.to_json(path, orient="records", lines=False)
    else:
        raise ValueError("Unsupported output extension. Use .csv/.xlsx/.json")
    LOGGER.info("Saved predictions to %s", path)


def parse_args(argv: Optional[list] = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Prediction pipeline")
    p.add_argument("--input", "-i", required=True, help="Input file (CSV/JSON/XLSX) with features")
    p.add_argument("--model", "-m", required=True, help="Trained model file (joblib/pickle)")
    p.add_argument("--scaler", "-s", required=False, help="Optional scaler/preprocessor (joblib/pickle)")
    p.add_argument("--encoder", "-e", required=False, help="Optional encoder for categorical features (joblib/pickle)")
    p.add_argument("--features", "-f", nargs="*", help="Optional explicit list of feature columns to use")
    p.add_argument("--output", "-o", required=True, help="Output file to write predictions (CSV/JSON/XLSX)")
    return p.parse_args(argv)


def main(argv: Optional[list] = None) -> None:
    args = parse_args(argv)

    LOGGER.info("Reading input: %s", args.input)
    df = read_input(args.input)

    model = load_model(args.model)
    scaler = load_optional_artifact(args.scaler)
    encoder = load_optional_artifact(args.encoder)

    y_pred, y_proba = predict_from_dataframe(df, model, scaler=scaler, encoder=encoder, feature_columns=args.features)

    out_df = df.copy()
    out_df["prediction"] = y_pred
    if y_proba is not None:
        # If multi-class, create columns proba_0, proba_1, ...
        if y_proba.ndim == 2 and y_proba.shape[1] > 1:
            for i in range(y_proba.shape[1]):
                out_df[f"proba_{i}"] = y_proba[:, i]
        else:
            out_df["proba"] = y_proba.flatten()

    write_output(out_df, args.output)
    LOGGER.info("Prediction pipeline completed.")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        LOGGER.exception("Pipeline failed: %s", exc)
        sys.exit(1)