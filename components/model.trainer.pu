"""
Model trainer module for training, evaluating, saving and loading ML models.

Usage:
    python model.trainer.py --data path/to/data.csv --target target_column --out model.joblib

This module auto-detects whether the problem is classification or regression
based on the target column dtype (object/categorical -> classification, numeric -> regression).
"""

from __future__ import annotations
import argparse
import json
from dataclasses import dataclass, asdict
from typing import Optional, Dict, Any, Tuple
import os

import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OrdinalEncoder
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor
from sklearn.metrics import (
    accuracy_score,
    f1_score,
    precision_score,
    recall_score,
    mean_squared_error,
    mean_absolute_error,
    r2_score,
)
import joblib


@dataclass
class TrainerConfig:
    random_state: int = 42
    test_size: float = 0.2
    classifier_params: Dict[str, Any] = None
    regressor_params: Dict[str, Any] = None


class ModelTrainer:
    def __init__(self, config: Optional[TrainerConfig] = None):
        self.config = config or TrainerConfig()
        if self.config.classifier_params is None:
            self.config.classifier_params = {"n_estimators": 100, "random_state": self.config.random_state}
        if self.config.regressor_params is None:
            self.config.regressor_params = {"n_estimators": 100, "random_state": self.config.random_state}
        self.pipeline: Optional[Pipeline] = None
        self.task: Optional[str] = None  # 'classification' or 'regression'
        self.feature_names: Optional[list] = None
        self.target_name: Optional[str] = None

    def _infer_task(self, y: pd.Series) -> str:
        if pd.api.types.is_numeric_dtype(y):
            # numeric target: treat as regression unless small number of unique ints -> classification
            unique = y.dropna().unique()
            if pd.api.types.is_integer_dtype(y) and len(unique) <= 20:
                return "classification"
            return "regression"
        else:
            return "classification"

    def _build_pipeline(self, X: pd.DataFrame) -> Pipeline:
        # Separate numeric and categorical features
        numeric_cols = X.select_dtypes(include=["number"]).columns.tolist()
        categorical_cols = X.select_dtypes(exclude=["number"]).columns.tolist()

        numeric_pipe = Pipeline(
            steps=[
                ("imputer", SimpleImputer(strategy="mean")),
                ("scaler", StandardScaler()),
            ]
        )
        categorical_pipe = Pipeline(
            steps=[
                ("imputer", SimpleImputer(strategy="constant", fill_value="__MISSING__")),
                ("encoder", OrdinalEncoder(handle_unknown="use_encoded_value", unknown_value=-1)),
            ]
        )

        preprocessor = ColumnTransformer(
            transformers=[
                ("num", numeric_pipe, numeric_cols),
                ("cat", categorical_pipe, categorical_cols),
            ],
            remainder="drop",
        )

        if self.task == "classification":
            estimator = RandomForestClassifier(**self.config.classifier_params)
        else:
            estimator = RandomForestRegressor(**self.config.regressor_params)

        pipeline = Pipeline(steps=[("preprocessor", preprocessor), ("estimator", estimator)])
        return pipeline

    def fit(self, df: pd.DataFrame, target: str) -> Dict[str, Any]:
        if target not in df.columns:
            raise ValueError(f"target column '{target}' not found in dataframe")

        self.target_name = target
        X = df.drop(columns=[target])
        y = df[target]

        self.task = self._infer_task(y)
        self.feature_names = X.columns.tolist()

        X_train, X_test, y_train, y_test = train_test_split(
            X, y, test_size=self.config.test_size, random_state=self.config.random_state, stratify=y if self.task == "classification" else None
        )

        self.pipeline = self._build_pipeline(X_train)
        self.pipeline.fit(X_train, y_train)

        metrics = self.evaluate(X_test, y_test)
        return metrics

    def evaluate(self, X: pd.DataFrame, y: pd.Series) -> Dict[str, Any]:
        if self.pipeline is None:
            raise RuntimeError("Model pipeline is not fitted. Call fit() first or load() a model.")

        preds = self.pipeline.predict(X)
        results: Dict[str, Any] = {"task": self.task}

        if self.task == "classification":
            # support multi-class metrics with average='weighted'
            results.update(
                {
                    "accuracy": float(accuracy_score(y, preds)),
                    "f1_weighted": float(f1_score(y, preds, average="weighted", zero_division=0)),
                    "precision_weighted": float(precision_score(y, preds, average="weighted", zero_division=0)),
                    "recall_weighted": float(recall_score(y, preds, average="weighted", zero_division=0)),
                }
            )
        else:
            results.update(
                {
                    "mse": float(mean_squared_error(y, preds)),
                    "mae": float(mean_absolute_error(y, preds)),
                    "r2": float(r2_score(y, preds)),
                }
            )
        return results

    def predict(self, df: pd.DataFrame) -> np.ndarray:
        if self.pipeline is None:
            raise RuntimeError("Model pipeline is not fitted. Call fit() first or load() a model.")
        return self.pipeline.predict(df)

    def save(self, path: str) -> None:
        if self.pipeline is None:
            raise RuntimeError("No trained pipeline to save.")
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        payload = {
            "pipeline": self.pipeline,
            "task": self.task,
            "feature_names": self.feature_names,
            "target_name": self.target_name,
            "config": asdict(self.config),
        }
        joblib.dump(payload, path)

    def load(self, path: str) -> None:
        payload = joblib.load(path)
        self.pipeline = payload.get("pipeline")
        self.task = payload.get("task")
        self.feature_names = payload.get("feature_names")
        self.target_name = payload.get("target_name")
        cfg = payload.get("config")
        if cfg:
            self.config = TrainerConfig(**cfg)


def _read_csv(path: str) -> pd.DataFrame:
    return pd.read_csv(path)


def main(argv=None):
    parser = argparse.ArgumentParser(description="Train a simple model and save it.")
    parser.add_argument("--data", "-d", required=True, help="Path to CSV dataset")
    parser.add_argument("--target", "-t", required=True, help="Name of the target column")
    parser.add_argument("--out", "-o", required=True, help="Path to save trained model (.joblib)")
    parser.add_argument("--test-size", type=float, default=0.2, help="Test split fraction")
    parser.add_argument("--random-state", type=int, default=42, help="Random seed")
    args = parser.parse_args(argv)

    df = _read_csv(args.data)
    cfg = TrainerConfig(random_state=args.random_state, test_size=args.test_size)
    trainer = ModelTrainer(config=cfg)
    metrics = trainer.fit(df, args.target)

    trainer.save(args.out)

    summary = {"saved_to": args.out, "metrics": metrics}
    print(json.dumps(summary, indent=2))


if __name__ == "__main__":
    main()